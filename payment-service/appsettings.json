{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaConsumerConfig": {
    "BootstrapServers": "kafka:29092",
    "PaymentRequestTopic": "payment-requests",
    "PaymentRequestGroupId": "payment-service-payment-requests-v1",
    "PaymentRequestFailureRetryDelaySeconds": 5
  },
  "PaymentMethodTokens": {
    "LifetimeSeconds": 300,
    "CleanupIntervalSeconds": 300,
    "RetentionSeconds": 86400
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres-payments;Port=5432;Database=paymentdb;Username=postgres;Password=postgres"
  },
  "ConsulConfig": {
    "ServiceId": "payment-service",
    "ServiceName": "payment-service",
    "ServiceAddress": "http://localhost",
    "ServicePort": 5000,
    "HealthCheckUrl": "http://payment-service:8080/health",
    "HealthCheckIntervalSeconds": 10,
    "HealthCheckTimeoutSeconds": 5,
    "ConsulAddress": "http://consul:8500"
  }
}
