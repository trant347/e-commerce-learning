# Sample .env additions for Phase 3 (Mongo auth)
# Copy these into your local .env and set strong passwords.
# .env is gitignored — do NOT commit real secrets.

# Mongo root credentials (used only for the initial container bootstrap).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme-root

# Per-service application users (least-privilege: readWrite on one DB only).
JwtSecret=replace-with-at-least-32-characters-long-random-secret

MongoBookingDatabaseName=<SthDB>
ConnectionsString=<mongodb://mongodb:27017>

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=changeme-auth

PRODUCTS_DB_USER=products_user
PRODUCTS_DB_PASSWORD=changeme-products

BOOKINGS_DB_USER=bookings_user
BOOKINGS_DB_PASSWORD=changeme-bookings

NOTIFICATIONS_DB_USER=notifications_user
NOTIFICATIONS_DB_PASSWORD=changeme-notifications

PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=changeme-payments

# Dedicated payment-service wallet that holds funded escrow. This is an internal account id,
# not an administrator selected from application users.
PAYMENT_CUSTODY_USER_ID=admin-custody

# ─── AI assistant model provider (see docs/AI_ASSISTANT_DEPLOYMENT.md) ───
# Default (local Ollama): leave these empty and run
#   docker compose up -d --build
# OpenRouter-only chat: set both values below, then run
#   docker compose -f docker-compose.yml -f docker-compose.openrouter.yml up -d --build
# Use a dedicated TaskMaster Hub key with the smallest practical credit limit and
# verified spending alerts (a key limit is not an alert). One key is shared by
# every OpenRouter task. In-flight calls can overshoot limits; see the task-12
# stop thresholds in docs/AI_ASSISTANT_DEPLOYMENT.md.
# Never commit a real key; rotate it immediately if exposed.
OPENROUTER_API_KEY=
# A model slug that supports both `tools` and `max_tokens` (check its OpenRouter model page).
OPENROUTER_CHAT_MODEL=
# Optional attribution. When set, it must be an absolute HTTP(S) URL; the app is sent as hidden.
OPENROUTER_HTTP_REFERER=

# Jev category decisions are separate from the chat model and remain disabled
# until the evaluated catalog/model/policy, spend cap and operator approval exist.
# Leave legacy + ChatModel for the default deployment. To opt in after approval,
# set the mode to catalog-llm (or hybrid), provider to Jev, and ALL fields below.
# Jev uses the shared OPENROUTER_API_KEY even when chat stays on local Ollama.
# Do not put the Jev Decisions model in OPENROUTER_CHAT_MODEL.
JEV_CATEGORY_MODE=legacy
JEV_CATEGORY_SEMANTIC_PROVIDER=ChatModel
JEV_CATEGORY_MODEL=
JEV_CATEGORY_ENDPOINT=
JEV_CATEGORY_TIMEOUT_SECONDS=
JEV_POLICY_VERSION=
JEV_POLICY_EVALUATED_MODEL=
JEV_POLICY_EVALUATED_CATALOG_VERSION=
JEV_POLICY_MINIMUM_CONFIDENCE=
JEV_POLICY_MINIMUM_PROBABILITY=
JEV_POLICY_MINIMUM_MARGIN=
JEV_POLICY_DISTRIBUTION_TOLERANCE=
