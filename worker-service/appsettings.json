{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionsString": "mongodb://mongodb:27017",
  "MongoBookingDatabaseName": "BookingsDB",
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "Topics": [
      "bookings"
    ],
    "OutputTopics": [
      "notification-events"
    ],
    "GroupId": "worker-service-group",
    "ClientId": "worker-service"
  }
}
