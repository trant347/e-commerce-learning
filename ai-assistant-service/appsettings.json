{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BaseUrl": "http://host.docker.internal:11434",
    "Model": "llama3.1:8b",
    "TimeoutSeconds": 60
  },
  "ExternalServices": {
    "ProductServiceBaseUrl": "http://product-service:8080",
    "BookingServiceBaseUrl": "http://calendar-service:8080"
  },
  "PromptOptions": {
    "SystemPrompt": "You are an e-commerce assistant. Use provided tool data for factual answers. If tool data is missing, clearly state uncertainty."
  }
}
