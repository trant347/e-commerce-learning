{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },  
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDB": "mongodb://mongo-notifications:27017/NotificationDB"
  },
  "ConsulConfig": {
    "Address": "http://consul:8500",
    "ServiceName": "notification-service",
    "ServiceId": "notification-service",
    "ServiceAddress": "notification-service",
    "HealthCheckUrl": "http://notification-service:8080/health",
    "ServicePort": 8080
  },
  "KafkaConsumerConfig": {
    "BootstrapServers": "kafka:29092",
    "GroupId": "notification-service-group",
    "Topic": [
      "notification-events"
    ],
    "AutoCommit": true
  }
}
